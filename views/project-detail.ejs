<div class="container py-5"><a href="/projects" class="text-decoration-none">← All Projects</a><div class="row g-5 mt-1"><div class="col-lg-7"><% if(project.cover_image){ %><img src="<%=project.cover_image%>" class="img-fluid rounded-4 shadow-sm w-100" style="max-height:520px;object-fit:cover" alt="<%=project.title%>"><% } %><% if(images.length){ %><div class="row g-3 mt-2"><% images.forEach(im=>{ %><div class="col-6"><img src="<%=im.image_path%>" class="img-fluid rounded-3" style="height:180px;width:100%;object-fit:cover" alt="<%=im.caption||project.title%>"></div><% }) %></div><% } %></div><div class="col-lg-5"><span class="badge bg-light text-dark mb-2"><%=project.category_name||'Project'%></span><h1 class="fw-bold"><%=project.title%></h1><% if(project.location){ %><p><i class="bi bi-geo-alt"></i> <%=project.location%></p><% } %><% if(project.client_name){ %><p><strong>Client:</strong> <%=project.client_name%></p><% } %><% if(project.project_date){ %><p><strong>Date:</strong> <%=new Date(project.project_date).toLocaleDateString('en-IN')%></p><% } %><% if(project.technology){ %><p><strong>Technology:</strong> <%=project.technology%></p><% } %><hr><div style="white-space:pre-line"><%=project.description||''%></div><a href="/contact" class="btn btn-dark mt-4">Discuss a Similar Project</a></div></div></div>
