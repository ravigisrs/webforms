<div class="container py-5"><div class="text-center mb-5"><div class="text-uppercase small fw-bold text-warning">HGC Portfolio</div><h1 class="fw-bold">Our Projects</h1><p class="text-muted">Selected GIS, surveying, LiDAR, drone and geomatics projects.</p></div><div class="row g-4"><% if(!projects.length){ %><div class="col-12 text-center text-muted">Projects will be published here soon.</div><% } %><% projects.forEach(p=>{ %><div class="col-md-6 col-lg-4"><article class="card h-100 border-0 shadow-sm overflow-hidden"><% if(p.cover_image){ %><img src="<%=p.cover_image%>" class="card-img-top" style="height:220px;object-fit:cover" alt="<%=p.title%>"><% } else { %><div style="height:220px;background:#0b2638;display:flex;align-items:center;justify-content:center;color:#9bded5;font-size:3rem"><i class="bi bi-map"></i></div><% } %><div class="card-body"><span class="badge bg-light text-dark mb-2"><%=p.category_name||'Project'%></span><h3 class="h5 fw-bold"><%=p.title%></h3><p class="text-muted"><%=p.description?p.description.slice(0,150):'Geomatics and geospatial project.'%><%=p.description&&p.description.length>150?'...':''%></p><a href="/projects/<%=p.slug%>" class="btn btn-outline-dark btn-sm">View Project →</a></div></article></div><% }) %></div></div>
