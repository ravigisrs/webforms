<div class="container py-5"><div class="text-center mb-5"><div class="text-uppercase small fw-bold text-warning">HGC Gallery</div><h1 class="fw-bold">Our Work in Pictures</h1><p class="text-muted">Survey, GIS, LiDAR, drone and geomatics field work.</p></div><div class="row g-4"><% if(!images.length){ %><div class="col-12 text-center text-muted">Gallery images will be published here soon.</div><% } %><% images.forEach(img=>{ %><div class="col-sm-6 col-lg-4"><figure class="card border-0 shadow-sm overflow-hidden h-100 mb-0"><img src="<%=img.image_path%>" class="w-100" style="height:250px;object-fit:cover" alt="<%=img.title||'HGC Gallery'%>"><figcaption class="card-body"><div class="small text-warning fw-bold"><%=img.category||'HGC'%></div><h3 class="h6 fw-bold mb-1"><%=img.title||'HGC Project'%></h3><p class="small text-muted mb-0"><%=img.caption||''%></p></figcaption></figure></div><% }) %></div></div>
