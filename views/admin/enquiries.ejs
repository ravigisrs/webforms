<div class="container-fluid p-4"><div class="mb-4"><h1 class="h3 mb-1">Customer Enquiries</h1><div class="text-muted">Manage Get a Quote and contact requests.</div></div><% if(deleted){ %><div class="alert alert-success">Enquiry deleted.</div><% } %><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>ID</th><th>Customer</th><th>Contact</th><th>Service</th><th>Company</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody><% if(!enquiries.length){ %><tr><td colspan="8" class="text-center text-muted py-5">No enquiries received yet.</td></tr><% } %><% enquiries.forEach(e=>{ %><tr><td>#<%=e.id%></td><td><strong><%=e.name%></strong></td><td><%=e.mobile||'-'%><br><span class="small text-muted"><%=e.email||''%></span></td><td><%=e.service_name||'General Enquiry'%></td><td><%=e.company||'-'%></td><td><span class="badge <%=e.status==='new'?'bg-warning text-dark':e.status==='contacted'?'bg-info text-dark':'bg-success'%>"><%=e.status%></span></td><td class="small"><%=new Date(e.created_at).toLocaleString('en-IN')%></td><td><a class="btn btn-sm btn-outline-dark" href="/admin/enquiries/<%=e.id%>">View</a></td></tr><% }) %></tbody></table></div></div></div>
