<div class="container-fluid p-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Gallery</h1><div class="text-muted">Upload and manage company photographs.</div></div><a href="/gallery" target="_blank" class="btn btn-outline-dark">View Gallery</a></div><% if(saved){ %><div class="alert alert-success">Images uploaded successfully.</div><% } %><% if(deleted){ %><div class="alert alert-success">Image deleted.</div><% } %><div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Upload Gallery Images</h2><form action="/admin/gallery/upload" method="post" enctype="multipart/form-data" class="row g-3"><div class="col-md-4"><label class="form-label">Title</label><input name="title" class="form-control" placeholder="GIS Survey Project"></div><div class="col-md-3"><label class="form-label">Category</label><select name="category" class="form-select"><option>GIS</option><option>Survey</option><option>DGPS</option><option>LiDAR</option><option>UAV / Drone</option><option>Bathymetry</option><option>Land Demarcation</option><option>Other</option></select></div><div class="col-md-5"><label class="form-label">Images</label><input name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple required class="form-control"></div><div class="col-12"><label class="form-label">Caption</label><input name="caption" class="form-control" placeholder="Short caption for these images"></div><div class="col-12"><button class="btn btn-dark">Upload Images</button><span class="text-muted small ms-3">JPG, PNG or WEBP · max 5 MB each · up to 30 images</span></div></form></div></div><div class="row g-4"><% if(!images.length){ %><div class="col-12"><div class="text-muted text-center py-5">No gallery images yet.</div></div><% } %><% images.forEach(img=>{ %><div class="col-sm-6 col-lg-3"><div class="card h-100 shadow-sm border-0 overflow-hidden"><img src="<%=img.image_path%>" style="height:190px;object-fit:cover" alt="<%=img.title||'HGC Gallery'%>"><div class="card-body"><div class="small text-warning fw-bold"><%=img.category||'General'%></div><div class="fw-semibold"><%=img.title||'Gallery Image'%></div><div class="small text-muted mb-3"><%=img.caption||''%></div><div class="d-flex gap-2"><form method="post" action="/admin/gallery/<%=img.id%>/toggle"><button class="btn btn-sm btn-outline-secondary"><%=img.is_active?'Hide':'Show'%></button></form><form method="post" action="/admin/gallery/<%=img.id%>/delete" onsubmit="return confirm('Delete this image?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div></div><% }) %></div></div>
