<div class="admin-shell"><%- include("./_sidebar") %><main class="admin-content"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Projects</h2><p class="text-muted mb-0">Manage your GIS, survey, LiDAR, drone and other project portfolio items.</p></div><a href="/admin/projects/new" class="btn btn-gold"><i class="bi bi-plus-lg"></i> Add Project</a></div><% if(saved){ %><div class="alert alert-success">Project saved successfully.</div><% } %><% if(deleted){ %><div class="alert alert-warning">Project deleted.</div><% } %><div class="cms-card p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Project</th><th>Category</th><th>Location</th><th>Images</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><% if(!projects.length){ %><tr><td colspan="6" class="text-center py-5 text-muted">No projects yet. Click <b>Add Project</b> to create your first project.</td></tr><% } %><% projects.forEach(p=>{ %><tr><td><div class="d-flex align-items-center gap-3"><% if(p.cover_image){ %><img src="<%=p.cover_image%>" class="project-thumb" alt=""><% } else { %><div class="project-thumb project-thumb-empty"><i class="bi bi-image"></i></div><% } %><div><div class="fw-bold"><%=p.title%></div><small class="text-muted"><%=p.client_name||''%></small></div></div></td><td><%=p.category_name||'-'%></td><td><%=p.location||'-'%></td><td><span class="badge text-bg-light"><%=p.image_count%></span></td><td><span class="badge <%=p.is_active?'text-bg-success':'text-bg-secondary'%>"><%=p.is_active?'Published':'Hidden'%></span></td><td class="text-end"><a class="btn btn-sm btn-outline-dark" href="/admin/projects/<%=p.id%>/edit"><i class="bi bi-pencil"></i></a> <form class="d-inline" method="post" action="/admin/projects/<%=p.id%>/toggle"><button class="btn btn-sm btn-outline-primary" title="Toggle"><i class="bi bi-eye"></i></button></form> <form class="d-inline" method="post" action="/admin/projects/<%=p.id%>/delete" onsubmit="return confirm('Delete this project and its gallery images?')"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr><% }) %></tbody></table></div></div></main></div>
