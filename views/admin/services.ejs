<div class="admin-shell"><%- include("./_sidebar") %><main class="admin-content"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Services</h2><p class="text-muted mb-0">Add, edit, publish or delete website services.</p></div><a href="/admin/services/new" class="btn btn-gold"><i class="bi bi-plus-lg"></i> Add Service</a></div><% if(saved){ %><div class="alert alert-success">Service saved successfully.</div><% } %><% if(deleted){ %><div class="alert alert-warning">Service deleted.</div><% } %><div class="cms-card p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Order</th><th>Service</th><th>Category</th><th>Featured</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><% services.forEach(s=>{ %><tr><td><%=s.display_order%></td><td><div class="fw-bold"><i class="bi <%=s.icon||'bi-map'%> me-2 text-success"></i><%=s.title%></div><small class="text-muted"><%=s.short_description||''%></small></td><td><%=s.category_name||'-'%></td><td><%=s.is_featured?'Yes':'No'%></td><td><span class="badge <%=s.is_active?'text-bg-success':'text-bg-secondary'%>"><%=s.is_active?'Published':'Hidden'%></span></td><td class="text-end"><a class="btn btn-sm btn-outline-dark" href="/admin/services/<%=s.id%>/edit"><i class="bi bi-pencil"></i></a> <form class="d-inline" method="post" action="/admin/services/<%=s.id%>/toggle"><button class="btn btn-sm btn-outline-primary" title="Toggle"><i class="bi bi-eye"></i></button></form> <form class="d-inline" method="post" action="/admin/services/<%=s.id%>/delete" onsubmit="return confirm('Delete this service?')"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr><% }) %></tbody></table></div></div></main></div>
