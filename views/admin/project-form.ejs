<div class="admin-shell"><%- include("./_sidebar") %><main class="admin-content"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2><%=mode==='edit'?'Edit Project':'Add Project'%></h2><p class="text-muted mb-0">Create a professional project portfolio entry.</p></div><a href="/admin/projects" class="btn btn-outline-dark">← Back to Projects</a></div><% if(typeof saved!=='undefined' && saved){ %><div class="alert alert-success">Project saved successfully.</div><% } %><form method="post" action="<%=mode==='edit'?'/admin/projects/'+project.id:'/admin/projects'%>" enctype="multipart/form-data"><input type="hidden" name="existing_cover" value="<%=project.cover_image||''%>"><div class="cms-card"><h5>Project Information</h5><div class="row g-3"><div class="col-md-8"><label>Project Title</label><input required class="form-control" name="title" value="<%=project.title||''%>"></div><div class="col-md-4"><label>Category</label><select class="form-select" name="category_id"><option value="">Select category</option><% categories.forEach(c=>{ %><option value="<%=c.id%>" <%=String(project.category_id||'')===String(c.id)?'selected':''%>><%=c.name%></option><% }) %></select></div><div class="col-md-6"><label>Client Name</label><input class="form-control" name="client_name" value="<%=project.client_name||''%>"></div><div class="col-md-6"><label>Project Location</label><input class="form-control" name="location" value="<%=project.location||''%>"></div><div class="col-md-4"><label>Project Date</label><input type="date" class="form-control" name="project_date" value="<%=project.project_date?new Date(project.project_date).toISOString().slice(0,10):''%>"></div><div class="col-md-8"><label>Technology / Equipment</label><input class="form-control" name="technology" placeholder="DGPS, Total Station, GIS, LiDAR..." value="<%=project.technology||''%>"></div><div class="col-12"><label>Description</label><textarea class="form-control" rows="6" name="description"><%=project.description||''%></textarea></div><div class="col-md-6"><label>Latitude</label><input class="form-control" name="latitude" value="<%=project.latitude||''%>"></div><div class="col-md-6"><label>Longitude</label><input class="form-control" name="longitude" value="<%=project.longitude||''%>"></div></div></div><div class="cms-card"><h5>Cover Image</h5><div class="row g-3 align-items-center"><div class="col-md-4"><% if(project.cover_image){ %><img src="<%=project.cover_image%>" class="project-cover-preview" alt="Project cover"><% } else { %><div class="project-cover-empty"><i class="bi bi-image"></i><span>No cover image</span></div><% } %></div><div class="col-md-8"><label>Upload Cover Image</label><input type="file" class="form-control" name="cover_image" accept="image/jpeg,image/png,image/webp"><small class="text-muted">JPG, PNG or WEBP. Maximum 5 MB.</small></div></div></div><div class="cms-card"><h5>Publishing</h5><div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" name="is_featured" <%=project.is_featured?'checked':''%>><label class="form-check-label">Featured Project</label></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="is_active" <%=project.is_active?'checked':''%>><label class="form-check-label">Published on website</label></div></div><div class="sticky-save"><button class="btn btn-gold px-4"><i class="bi bi-check2"></i> <%=mode==='edit'?'Update Project':'Save Project'%></button></div></form><% if(mode==='edit'){ %><div class="cms-card mt-4"><h5>Project Gallery</h5><form method="post" action="/admin/projects/<%=project.id%>/images" enctype="multipart/form-data"><div class="row g-3 align-items-end"><div class="col-md-8"><label>Add Images</label><input type="file" class="form-control" name="images" accept="image/jpeg,image/png,image/webp" multiple></div><div class="col-md-4"><label>Caption (optional)</label><input class="form-control" name="caption"></div><div class="col-12"><button class="btn btn-dark">Upload Images</button></div></div></form><div class="row g-3 mt-2"><% if((images||[]).length){ images.forEach(im=>{ %><div class="col-6 col-md-3"><div class="gallery-admin-card"><img src="<%=im.image_path%>" alt=""><form method="post" action="/admin/projects/images/<%=im.id%>/delete" onsubmit="return confirm('Delete this image?')"><button class="btn btn-sm btn-outline-danger w-100 mt-2"><i class="bi bi-trash"></i> Delete</button></form></div></div><% }) } else { %><div class="col-12 text-muted">No gallery images yet.</div><% } %></div></div><% } %></main></div>
