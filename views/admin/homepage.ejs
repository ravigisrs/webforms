<div class="admin-shell"><%- include("./_sidebar") %><main class="admin-content"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Homepage CMS</h2><p class="text-muted mb-0">Edit the public homepage without coding.</p></div><a href="/" target="_blank" class="btn btn-outline-dark">Preview Website ↗</a></div><% if(saved){ %><div class="alert alert-success">Homepage updated successfully.</div><% } %><form method="post" action="/admin/homepage"><div class="cms-card"><h5>Hero Section</h5><div class="row g-3"><div class="col-12"><label>Small Label</label><input name="hero_kicker" class="form-control" value="<%=home.hero_kicker||''%>"></div><div class="col-md-6"><label>Main Heading</label><input name="hero_title" class="form-control" value="<%=home.hero_title||''%>"></div><div class="col-md-6"><label>Highlighted Heading</label><input name="hero_highlight" class="form-control" value="<%=home.hero_highlight||''%>"></div><div class="col-12"><label>Description</label><textarea name="hero_description" class="form-control" rows="3"><%=home.hero_description||''%></textarea></div></div></div><div class="cms-card"><h5>Service Highlights</h5><div class="row g-3"><% for(let i=1;i<=4;i++){ %><div class="col-md-6 col-xl-3"><label>Box <%=i%> Title</label><input name="stat<%=i%>_title" class="form-control mb-2" value="<%=home['stat'+i+'_title']||''%>"><label>Box <%=i%> Text</label><input name="stat<%=i%>_text" class="form-control" value="<%=home['stat'+i+'_text']||''%>"></div><% } %></div></div><div class="cms-card"><h5>About Section</h5><div class="row g-3"><div class="col-md-4"><label>Section Label</label><input name="about_label" class="form-control" value="<%=home.about_label||''%>"></div><div class="col-md-8"><label>Heading</label><input name="about_title" class="form-control" value="<%=home.about_title||''%>"></div><div class="col-12"><label>Paragraph 1</label><textarea name="about_text1" class="form-control" rows="3"><%=home.about_text1||''%></textarea></div><div class="col-12"><label>Paragraph 2</label><textarea name="about_text2" class="form-control" rows="3"><%=home.about_text2||''%></textarea></div><div class="col-md-6"><label>Card Heading</label><input name="about_card_title" class="form-control" value="<%=home.about_card_title||''%>"></div><div class="col-md-6"><label>Card Text</label><input name="about_card_text" class="form-control" value="<%=home.about_card_text||''%>"></div></div></div><div class="cms-card"><h5>GIS Section</h5><div class="row g-3"><div class="col-md-4"><label>Section Label</label><input name="gis_label" class="form-control" value="<%=home.gis_label||''%>"></div><div class="col-md-8"><label>Heading</label><input name="gis_title" class="form-control" value="<%=home.gis_title||''%>"></div><div class="col-12"><label>Description</label><textarea name="gis_description" class="form-control" rows="3"><%=home.gis_description||''%></textarea></div></div></div><div class="cms-card"><h5>Bottom CTA</h5><div class="row g-3"><div class="col-md-4"><label>Label</label><input name="cta_label" class="form-control" value="<%=home.cta_label||''%>"></div><div class="col-md-8"><label>Heading</label><input name="cta_title" class="form-control" value="<%=home.cta_title||''%>"></div><div class="col-12"><label>Description</label><textarea name="cta_description" class="form-control" rows="3"><%=home.cta_description||''%></textarea></div></div></div><div class="sticky-save"><button class="btn btn-gold btn-lg px-5"><i class="bi bi-check2-circle"></i> Save Homepage</button></div></form></main></div>
