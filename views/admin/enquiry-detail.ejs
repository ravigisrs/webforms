<div class="container-fluid p-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Enquiry #<%=enquiry.id%></h1><div class="text-muted">Received <%=new Date(enquiry.created_at).toLocaleString('en-IN')%></div></div><a href="/admin/enquiries" class="btn btn-outline-dark">← Back</a></div><div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5 mb-4">Customer Details</h2><div class="row g-3"><div class="col-md-6"><div class="text-muted small">Name</div><div class="fw-semibold"><%=enquiry.name%></div></div><div class="col-md-6"><div class="text-muted small">Mobile</div><div class="fw-semibold"><%=enquiry.mobile||'-'%></div></div><div class="col-md-6"><div class="text-muted small">Email</div><div><%=enquiry.email||'-'%></div></div><div class="col-md-6"><div class="text-muted small">Company</div><div><%=enquiry.company||'-'%></div></div><div class="col-md-6"><div class="text-muted small">Requested Service</div><div><%=enquiry.service_name||'General Enquiry'%></div></div><div class="col-12"><div class="text-muted small">Message</div><div class="border rounded p-3 bg-light" style="white-space:pre-wrap"><%=enquiry.message||''%></div></div></div></div></div></div><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Update Status</h2><form method="post" action="/admin/enquiries/<%=enquiry.id%>/status"><select name="status" class="form-select mb-3"><option value="new" <%=enquiry.status==='new'?'selected':''%>>New</option><option value="contacted" <%=enquiry.status==='contacted'?'selected':''%>>Contacted</option><option value="closed" <%=enquiry.status==='closed'?'selected':''%>>Closed</option></select><button class="btn btn-dark w-100">Save Status</button></form><hr><form method="post" action="/admin/enquiries/<%=enquiry.id%>/delete" onsubmit="return confirm('Delete this enquiry permanently?')"><button class="btn btn-outline-danger w-100">Delete Enquiry</button></form></div></div></div></div></div>
