<div class="admin-shell"><%- include("./_sidebar") %><main class="admin-content"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2><%=mode==='create'?'Add Service':'Edit Service'%></h2><p class="text-muted">Manage the service information shown on the public website.</p></div><a href="/admin/services" class="btn btn-outline-dark">← Back to Services</a></div><form method="post" action="<%=mode==='create'?'/admin/services':'/admin/services/'+service.id%>"><div class="cms-card"><div class="row g-3"><div class="col-md-8"><label>Service Name *</label><input name="title" class="form-control" required value="<%=service.title||''%>"></div><div class="col-md-4"><label>Category</label><select name="category_id" class="form-select"><option value="">Select category</option><% categories.forEach(c=>{ %><option value="<%=c.id%>" <%=String(service.category_id||'')===String(c.id)?'selected':''%>><%=c.name%></option><% }) %></select></div><div class="col-md-8"><label>Short Description</label><textarea name="short_description" class="form-control" rows="3"><%=service.short_description||''%></textarea></div><div class="col-md-4"><label>Bootstrap Icon</label><input name="icon" class="form-control" placeholder="bi-map" value="<%=service.icon||'bi-map'%>"><small class="text-muted">Example: bi-map, bi-crosshair, bi-water</small></div><div class="col-12"><label>Full Description</label><textarea name="description" class="form-control" rows="6"><%=service.description||''%></textarea></div><div class="col-md-8"><label>Image Path <span class="text-muted">(Phase 2.2 upload)</span></label><input name="image" class="form-control" value="<%=service.image||''%>" placeholder="/uploads/services/example.jpg"></div><div class="col-md-4"><label>Display Order</label><input name="display_order" type="number" class="form-control" value="<%=service.display_order||0%>"></div><div class="col-md-4"><div class="form-check form-switch mt-4"><input class="form-check-input" type="checkbox" name="is_featured" <%=service.is_featured?'checked':''%>><label class="form-check-label">Featured service</label></div></div><div class="col-md-4"><div class="form-check form-switch mt-4"><input class="form-check-input" type="checkbox" name="is_active" <%=service.is_active!==false?'checked':''%>><label class="form-check-label">Published / Active</label></div></div></div></div><button class="btn btn-gold btn-lg px-5">Save Service</button></form></main></div>
